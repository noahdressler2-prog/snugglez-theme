{%- render 'snugglez-fonts' -%}

{%- liquid
  assign form_id = 'SnugNewsletter-' | append: section.id
  assign heading_id = 'SnugNewsletterHeading-' | append: section.id
-%}

<section
  class="snug-news snug-section-pad snug-bg--{{ section.settings.section_background }}"
  style="--snug-pt: {{ section.settings.padding_top }}px; --snug-pb: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width">
    <div class="snug-news__card snug-bg--{{ section.settings.card_background }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <span class="snug-news__ring snug-news__ring--one" aria-hidden="true"></span>
      <span class="snug-news__ring snug-news__ring--two" aria-hidden="true"></span>

      <div class="snug-news__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="snug-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="{{ heading_id }}" class="snug-h2">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_accent != blank %}
            <em class="snug-accent snug-accent--line">{{ section.settings.heading_accent | escape }}</em>
          {%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="snug-news__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      <div class="snug-news__action">
        {%- form 'customer', id: form_id, class: 'snug-news__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div class="snug-news__success" role="status" tabindex="-1" autofocus>
              <span class="snug-news__success-mark" aria-hidden="true">
                {%- render 'snugglez-sparkle' -%}
              </span>
              <p class="snug-news__success-title">
                {{- section.settings.success_heading | escape }}
                <em class="snug-accent">{{ section.settings.success_accent | escape }}</em>
              </p>
            </div>
          {%- else -%}
            <div class="snug-field{% if form.errors %} snug-field--error{% endif %}">
              <label class="snug-field__label" for="{{ form_id }}-email">
                {{- section.settings.field_label | escape -}}
              </label>
              <div class="snug-field__row">
                <input
                  id="{{ form_id }}-email"
                  class="snug-field__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  placeholder="{{ section.settings.placeholder | escape }}"
                  required
                  aria-required="true"
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="{{ form_id }}-error"
                  {% else %}
                    aria-describedby="{{ form_id }}-fine"
                  {% endif %}
                >
                <button type="submit" class="snug-btn snug-btn--primary snug-field__submit" name="commit">
                  {{- section.settings.button_label | escape -}}
                </button>
              </div>
            </div>

            {%- if form.errors -%}
              <p id="{{ form_id }}-error" class="snug-field__error" role="alert">
                <span class="snug-field__error-icon" aria-hidden="true">!</span>
                <span>
                  {%- if form.errors.messages.email != blank -%}
                    {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                  {%- else -%}
                    {{ section.settings.error_fallback | escape }}
                  {%- endif -%}
                </span>
              </p>
            {%- endif -%}

            {%- if section.settings.fine_print != blank -%}
              <p id="{{ form_id }}-fine" class="snug-news__fine">{{ section.settings.fine_print | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Snugglez newsletter",
  "tag": "div",
  "class": "snug-section-wrap",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sign-ups are saved as customers tagged \"newsletter\" in Shopify admin. No discount is offered."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "[EDIT] Small line above heading",
      "default": "The newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "[EDIT] Heading",
      "default": "Join the inner circle."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "[EDIT] Heading italic accent",
      "default": "Tails will wag."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "[EDIT] Text",
      "default": "New arrivals, styling notes, and the occasional very good dog, delivered to your inbox."
    },
    {
      "type": "text",
      "id": "field_label",
      "label": "[EDIT] Email field label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "[EDIT] Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "[EDIT] Button label",
      "default": "Join"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "[EDIT] Fine print under the field",
      "default": "Unsubscribe anytime."
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "[EDIT] Success heading",
      "default": "You're in."
    },
    {
      "type": "text",
      "id": "success_accent",
      "label": "[EDIT] Success italic accent",
      "default": "Welcome to the inner circle."
    },
    {
      "type": "text",
      "id": "error_fallback",
      "label": "[EDIT] Error message fallback",
      "default": "Something went wrong. Please check your email and try again."
    },
    {
      "type": "select",
      "id": "card_background",
      "label": "Card background",
      "options": [
        { "value": "blush", "label": "Blush" },
        { "value": "cream-dark", "label": "Warm cream" },
        { "value": "white", "label": "White" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "blush"
    },
    {
      "type": "select",
      "id": "section_background",
      "label": "Section background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "cream-dark", "label": "Warm cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "Snugglez newsletter"
    }
  ]
}
{% endschema %}
